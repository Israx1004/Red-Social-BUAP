Options -Indexes

RewriteEngine On
# La app vive en http://host[:puerto]/RedSocial_BUAP/
RewriteBase /RedSocial_BUAP/

# Force HTTPS in production
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove trailing slashes (relativo a RewriteBase)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [L,R=301]

# Block direct access to backend except api-gateway
RewriteRule ^backend/microservices/ - [F,L]
RewriteRule ^backend/shared/ - [F,L]
RewriteRule ^backend/queue/ - [F,L]

# Carpetas internas que nunca deben servirse
RewriteRule ^(logs|database|docker|docs|websocket-server)(/|$) - [F,L]

# Archivos sensibles por extensión / nombre
<FilesMatch "\.(sql|bak|log|md|sh|env|example|txt|json|lock|yml)$|^\.">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
