# UniLink — Variables de entorno (Docker)
# Copia a .env y llena tus valores:  cp .env.example .env
# En XAMPP NO hace falta: helpers.php usa valores por defecto y genera
# el secreto JWT automáticamente en backend/shared/.jwt_secret

APP_ENV=production
APP_URL=http://localhost:8080/RedSocial_BUAP

# JWT (mínimo 32 caracteres aleatorios; setup.sh lo genera solo)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_32_CHAR_STRING_HERE

# Base de datos
DB_USER=unilink
DB_PASS=securepassword
DB_ROOT_PASSWORD=rootsecurepassword

# Redis
REDIS_PASSWORD=redissecret

# Email (SMTP) — necesario para correos de recuperación de contraseña
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
