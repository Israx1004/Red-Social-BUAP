# Archivos subidos por usuarios: NUNCA ejecutar código aquí
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .shtml
RemoveType .php .phtml .phar
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|shtml|html?|svg|js)$">
    Require all denied
</FilesMatch>
